---
const { url, title, user, icon } = Astro.props;
---

<article class="social-card">
  <a href={url} class="card-link">
    <img
      src={icon || "/favicon.svg"}
      alt={`Icono de ${title}`}
      class="card-icon"
    />

    <h3>{title}</h3>

    <p class="card-description">{user}</p>
  </a>
</article>

<style>
  .social-card {
    background-color: #f8f9fa;
    border-radius: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 220px;
    width: 100%;
    max-width: 200px;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 0;
    text-decoration: none;
    color: inherit;
  }

  .card-icon {
    object-fit: contain;
  }

  h3 {
    font-size: 1.4rem;
    margin: 0.7rem 0 0.5rem 0;
    color: #000000;
  }

  .card-description {
    font-size: 0.8rem;
    color: #6c757d;
    text-align: center;
    margin: 0;
  }

  .social-card:hover h3 {
    color: #0d6efd;
  }

  @media (max-width: 768px) {
    .social-card {
      min-height: 140px;
      max-width: 130px;
    }

    .card-link {
      padding: 1rem;
    }

    h3 {
      font-size: 1rem;
      margin: 0.5rem 0 0.2rem 0;
    }

    .card-description {
      font-size: 0.7rem;
    }

    .card-icon {
      width: 32px;
      height: 32px;
    }
  }
</style>
