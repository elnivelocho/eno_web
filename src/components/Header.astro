---
import Navigation from "./Navigation.astro";
import { Image } from "astro:assets";
import logoSVG from "../assets/logo.svg";
---

<header>
  <a href="/" aria-label="Inicio" class="logo-link">
    <Image
      src={logoSVG}
      alt="Logotipo principal"
      width={200}
      height={50}
      class="logo-img"
    />
  </a>
  <nav>
    <Navigation />
  </nav>
</header>

<style>
  header {
    width: 100%;
    max-width: 1000px;
    padding: 0 1.5rem;
    margin: 1rem auto 0rem auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: bold;
    text-decoration: none;
    color: #0d0950;
  }

  .logo-img {
    height: 2.5rem;
    width: auto;
  }
</style>
