---
const pathname = Astro.url.pathname;
---

<div id="main-menu" class="nav-links">
  <a href="/blog/" class={pathname.includes("/blog") ? "active" : ""}>Blog</a>
  <a href="/about/" class={pathname.includes("/about") ? "active" : ""}
    >Sobre mí</a
  >
</div>

<style>
  .nav-links {
    width: 100%;
    margin: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1.5rem;
  }

  @media (max-width: 600px) {
    .nav-links {
      justify-content: center;
    }
  }

  .nav-links a {
    display: block;
    text-align: center;
    padding: 10px 0;
    text-decoration: none;
    font-size: 1.2rem;
    text-transform: lowercase;
    color: #000000;
  }

  .nav-links a:hover,
  .nav-links a:focus {
    color: #0d6efd;
  }

  .nav-links a.active {
    font-weight: bold;
  }
</style>
