---
const pathname = Astro.url.pathname;
---

<div id="main-menu" class="nav-links">
  <a href="/blog/" class={pathname.includes("/blog") ? "active" : ""}>Blog</a>
  <a href="/about/" class={pathname.includes("/about") ? "active" : ""}
    >Acerca</a
  >
  <a href="/contact/" class={pathname.includes("/contact") ? "active" : ""}
    >Contacto</a
  >
</div>

<style>
  .nav-links {
    width: 100%;
    margin: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1.5rem;
  }

  @media (max-width: 600px) {
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background-color: rgba(244, 244, 244, 0.95);
      backdrop-filter: blur(10px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      padding: 1.5rem 0;
      z-index: 50;
      border-radius: 0 0 1rem 1rem;
    }

    .nav-links.active {
      display: flex;
    }
  }

  .nav-links a {
    display: block;
    text-align: center;
    padding: 10px 0;
    text-decoration: none;
    font-size: 1.2rem;
    text-transform: lowercase;
    color: #000000;
  }

  .nav-links a:hover,
  .nav-links a:focus {
    color: #0d6efd;
  }

  .nav-links a.active {
    font-weight: bold;
  }
</style>
