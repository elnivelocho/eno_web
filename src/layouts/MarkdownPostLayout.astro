---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;

const pubDateStr =
  frontmatter.pubDate instanceof Date
    ? frontmatter.pubDate.toISOString().slice(0, 10)
    : String(frontmatter.pubDate).slice(0, 10);
const pubTime = frontmatter.pubTime ?? "00:00";
const targetDateISO = `${pubDateStr}T${pubTime}:00`;
---

<BaseLayout pageTitle={frontmatter.title}>
  <div
    id="post-container"
    style="display: none;"
    data-target-date={targetDateISO}
  >
    <header class="article-header">
      <p class="article-description">{frontmatter.description}</p>

      <div class="article-meta">
        <span class="article-date">
          {
            new Date(frontmatter.pubDate).toLocaleDateString("es-ES", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
          {
            frontmatter.pubTime && (
              <span class="article-time"> · {frontmatter.pubTime}</span>
            )
          }
        </span>
        <span class="meta-separator">•</span>
        <span class="article-author">{frontmatter.author}</span>
      </div>

      <div class="tags">
        {
          frontmatter.tags.map((tag: string) => (
            <a class="tag" href={`/tags/${tag}`}>
              #{tag}
            </a>
          ))
        }
      </div>
    </header>

    <hr class="article-divider" />

    <article class="post-content">
      <slot />
    </article>
  </div>
</BaseLayout>

<script>
  const container = document.getElementById("post-container");

  if (container) {
    const targetDateStr = container.getAttribute("data-target-date");

    if (targetDateStr) {
      const publishAt = new Date(targetDateStr).getTime();
      const now = Date.now();

      if (now >= publishAt) {
        container.style.display = "block";
      } else {
        window.location.replace("/soon");
      }
    }
  }
</script>

<style>
  a {
    color: #00539f;
  }

  .article-header {
    margin-bottom: 2rem;
    padding-top: 0.5rem;
  }

  .article-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.1;
    color: #000000;
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  .article-description {
    font-size: 1.25rem;
    color: #4a4a4a;
    line-height: 1.5;
    margin: 0 0 1.5rem 0;
    font-weight: 400;
  }

  .article-meta {
    display: flex;
    align-items: center;
    color: #6c757d;
    font-size: 0.8rem;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .meta-separator {
    margin: 0 0.75rem;
    color: #ced4da;
  }

  .article-divider {
    border: 0;
    height: 1px;
    background-color: #e9ecef;
    margin: 1rem 0 2rem 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .tag {
    background-color: #ffffff;
    color: #495057;
    font-size: 0.85rem;
    padding: 0.35rem 0.75rem;
    border-radius: 100px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid #dee2e6;
    transition: background-color 0.2s ease, color 0.2s ease,
      border-color 0.2s ease;
  }

  .tag:hover {
    background-color: #0d6efd;
    color: white;
    border-color: #0d6efd;
  }

  .post-content {
    line-height: 1.8;
    font-size: 1rem;
    color: #000000;
  }

  /* Estilos para el texto Markdown inyectado */
  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3) {
    color: #000;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .post-content :global(h2) {
    font-size: 1.75rem;
  }

  .post-content :global(h3) {
    font-size: 1.5rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-content :global(a) {
    color: #0d6efd;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .post-content :global(a:hover) {
    border-bottom-color: #0d6efd;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid #0d6efd;
    margin: 1.5rem 0;
    padding: 0.5rem 0 0.5rem 1rem;
    color: #555;
    font-style: italic;
    background-color: transparent;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 2rem 0;
  }

  @media (max-width: 600px) {
    .article-title {
      font-size: 2.25rem;
    }
  }
</style>
