---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "@fontsource-variable/inter";
import "@fontsource/fira-sans/400.css";
import "@fontsource/fira-sans/700.css";

import { Image } from "astro:assets";
import bannerImg from "../assets/banner-eno-web.svg";

import "../styles/global.css";
const { pageTitle } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <div class="banner-wrapper">
      <Image
        src={bannerImg}
        alt="Banner de la página principal"
        class="banner-img"
      />
      <div class="banner-text-container">
        <h1 class="banner-title">El Nivel Ocho</h1>
        <p class="banner-subtitle">
          Divulgación de matemáticas, telecomunicaciones, informática e IA
        </p>
      </div>
    </div>
    <Footer />
    <script>
      import "../scripts/menu.js";
    </script>
  </body>
</html>

<style>
  .banner-wrapper {
    position: relative;
    padding: 0;
  }

  .banner-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .banner-text-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 90%;
  }

  .banner-title {
    color: black;
    font-family: "Inter Variable", sans-serif;
    font-weight: 700;
    font-size: clamp(1.5rem, 5vw, 4rem);
    margin: 0;
  }

  .banner-subtitle {
    color: black;
    font-family: "Inter Variable", sans-serif;
    font-weight: 400;
    font-size: clamp(0.75rem, 2vw, 1.5rem);
    margin: 0 auto;
    max-width: clamp(100px, 35vw, 500px);
    line-height: 1.4;
  }
</style>
