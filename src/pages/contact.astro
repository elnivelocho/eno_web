---
import Layout from "../layouts/Layout.astro";
import Social from "../components/Social.astro";
const pageTitle = "Contacto";
---

<Layout pageTitle={pageTitle}>
  <section class="contact-container">
    <h1>{pageTitle.toLowerCase()}</h1>
    <p class="joke-text">
      Mi registro MX apunta directamente a la 192.168.1.27. Es broma. Como no te
      configure un NAT estático, dudo que tu mensaje llegue.
    </p>
  </section>

  <div class="social-grid">
    <Social
      url="https://instagram.com/elnivelocho"
      title="Instagram"
      user="@elnivelocho"
      icon="../public/social/instagram_pink.svg"
    />
    <Social
      url="https://www.youtube.com/@ElNivelOcho"
      title="YouTube"
      user="@ElVivelOcho"
      icon="../public/social/youtube_red.svg"
    />
  </div>
</Layout>

<style>
  h1 {
    text-align: center;
  }

  .joke-text {
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
  }

  .social-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin: 2rem 0;
  }
</style>
